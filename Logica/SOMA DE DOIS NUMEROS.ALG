Algoritmo "Soma de dois numeros"
// Disciplina   : Java
// Professor   : Nelio Alves
// Descrição   : Soma de dois numeos e mostra na tela
// Autor(a)    : Rafael da Silva Santos
// Data atual  : 08/10/2026
Var
   n1, n2, soma : Inteiro


Inicio
   Escreva("Digite dois numeros: ")
   Leia(n1)
   Leia(n2)
   
   soma <- n1 + n2
   
   Escreva("Soma = ", soma)


Fimalgoritmo